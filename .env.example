# ============================================================
#  Grafica Lifei — Variaveis de Ambiente (EXEMPLO)
# ------------------------------------------------------------
#  Copie este ficheiro para `.env` e preencha com os seus valores.
#  O ficheiro `.env` NUNCA deve ser versionado (ver .gitignore).
# ============================================================

# --- Aplicacao ---
APP_NAME="Gráfica Lifei"
APP_ENV=local                 # local | production
APP_DEBUG=true                # true apenas em desenvolvimento
APP_URL=http://localhost/grafica_lifei/public
APP_TIMEZONE=Africa/Maputo
APP_LOCALE=pt

# --- Base de Dados (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=grafica_lifei
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Email / SMTP (PHPMailer) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls           # tls | ssl
MAIL_FROM_ADDRESS=geral@graficalifei.co.mz
MAIL_FROM_NAME="Gráfica Lifei"

# Destinatario das mensagens do formulario de contacto
MAIL_CONTACT_TO=geral@graficalifei.co.mz

# --- Seguranca ---
# Chave usada para assinar tokens (gere uma aleatoria com 32+ caracteres)
APP_KEY=

# Limite de tentativas (rate limiting)
RATE_LIMIT_LOGIN=5            # tentativas de login por janela
RATE_LIMIT_CONTACT=3          # envios de contacto por janela
RATE_LIMIT_WINDOW=900         # janela em segundos (900 = 15 min)
