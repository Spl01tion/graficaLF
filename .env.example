# ============================================================
#  Gráfica Lifei — Variáveis de Ambiente (EXEMPLO)
# ------------------------------------------------------------
#  Copie para `.env` e preencha. O `.env` NUNCA é versionado.
# ============================================================

# --- Aplicação ---
APP_NAME="Gráfica Lifei"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/grafica_lifei/public
APP_TIMEZONE=Africa/Maputo

# --- Base de Dados (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=graficalf_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Email / SMTP (PHPMailer) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=geral@graficalifei.co.mz
MAIL_FROM_NAME="Gráfica Lifei"

# Destinatário das mensagens de contacto e dos pedidos/encomendas
MAIL_CONTACT_TO=geral@graficalifei.co.mz
MAIL_ORDERS_TO=pedidos@graficalifei.co.mz

# --- Rate limiting (tentativas por janela) ---
RATE_LIMIT_LOGIN=5
RATE_LIMIT_CONTACT=3
RATE_LIMIT_ORDER=5
RATE_LIMIT_WINDOW=900
