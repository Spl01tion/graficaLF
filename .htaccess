# Protecção da raiz do projecto em desenvolvimento local (o XAMPP serve esta
# pasta directamente em http://localhost/grafica_lifei/...). Em produção este
# ficheiro não é enviado — é o public/.htaccess que passa a raiz do htdocs.
Options -Indexes

<FilesMatch "^(\.env.*|composer\.(json|lock)|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
