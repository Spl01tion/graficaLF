# ============================================================
#  Gráfica Lifei — Apache (pasta pública)
# ============================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ficheiros/pastas reais (css, js, imagens) são servidos directamente.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo o resto passa pelo front controller.
    RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
</IfModule>

# Impedir execução de PHP dentro da pasta de uploads (defesa contra
# web shells disfarçadas de imagem).
<IfModule mod_php.c>
    <Directory "uploads">
        php_admin_flag engine off
    </Directory>
</IfModule>
