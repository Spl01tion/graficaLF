# ============================================================
#  Gráfica Lifei — Apache (pasta pública)
# ============================================================

Options -Indexes

# Em produção (host partilhado), .env, composer.* e afins ficam ao lado
# deste ficheiro (ver README) — nunca devem ser acessíveis via HTTP.
<FilesMatch "^(\.env.*|composer\.(json|lock)|README\.md|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # SEO: sitemap e robots são gerados dinamicamente (o rewrite genérico
    # removeria o ponto do nome, por isso mapeamo-los explicitamente).
    RewriteRule ^sitemap\.xml$ index.php?url=sitemap [L]
    RewriteRule ^robots\.txt$  index.php?url=robots [L]

    # Ficheiros/pastas reais (css, js, imagens) são servidos directamente.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo o resto passa pelo front controller.
    RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
</IfModule>

# Nota: a protecção da pasta de uploads contra execução de PHP está no
# ficheiro public/uploads/.htaccess (blocos <Directory> não são permitidos
# dentro de um .htaccess — só na configuração principal do Apache).
